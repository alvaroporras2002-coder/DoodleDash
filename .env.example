# Public browser configuration only. Never place a service_role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Video credentials are server-only Pages bindings, not VITE_ variables:
# LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, VIDEO_ENABLED=true
# Set these in Cloudflare Settings > Variables and Secrets; do not commit values.
